{
  "name": "@infoticon/client",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Infoticon API v2 (company, IP, email domain and product lookups)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "api-client",
    "sdk",
    "openapi",
    "infoticon",
    "nip",
    "gus",
    "vat",
    "ean",
    "gtin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/infoticon/client.git"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "openapi-ts",
    "codegen:fetch": "curl -fsSL \"${OPENAPI_URL:-https://infoticon.prod.kubeticon.com/api/v2/documentation/json}\" -o openapi.json && npm run codegen",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.9.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.94.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
