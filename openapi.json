    "/api/v2/countries/{id}": {
      "get": {
        "operationId": "getCountry",
        "summary": "Get country dictionary entry by ISO 3166-1 alpha-2 code",
        "tags": [
          "Country"
        ],
        "description": "The same code that geolocation returns as countryCode. Read from the shared country dictionary — no external provider is involved.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "ISO 3166-1 alpha-2 country code, e.g. PL"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
