                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "nativeName": {
                      "type": "string"
                    },
                    "phonePrefixes": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "continent": {
                      "type": "string"
                    },
                    "capital": {
                      "type": "string"
                    },
                    "currencies": {
                      "type": "array",
