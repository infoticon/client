    "/api/v2/cards/{bin}": {
      "get": {
        "operationId": "getCard",
        "summary": "Get card issuer information by BIN/IIN",
        "tags": [
          "Money"
        ],
        "description": "Accepts the first 6 to 11 digits of a card number. Anything longer is rejected with 400: the server logs request URLs, so a full card number must never reach the path. The lookup never inspects digits past the 11th anyway. When several prefixes match, the longest one wins.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{6,11}$"
            },
            "in": "path",
            "name": "bin",
            "required": true,
            "description": "Card BIN/IIN — the first 6 to 11 digits. Do not send the full card number."
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "prefix": {
                      "type": "number"
                    },
                    "organization": {
                      "type": "string"
                    },
                    "issuer": {
                      "nullable": true,
                      "type": "string"
                    },
                    "type": {
                      "nullable": true,
                      "type": "string"
                    },
                    "product": {
                      "nullable": true,
                      "type": "string"
                    },
                    "countryCode": {
                      "nullable": true,
                      "type": "string"
                    },
                    "segment": {
                      "nullable": true,
                      "type": "string"
                    }
                  },
                  "required": [
                    "prefix",
                    "organization",
                    "issuer",
