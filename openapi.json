    "/api/v2/companies/{nip}": {
      "get": {
        "operationId": "getCompany",
        "summary": "Get company information by tax number (NIP)",
        "tags": [
          "Company"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 2
            },
            "in": "path",
            "name": "nip",
            "required": true,
            "description": "Tax number (NIP), optionally prefixed with country code (e.g. PL1234567890)"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "taxNumber": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "street": {
                      "nullable": true,
                      "type": "string"
                    },
                    "buildingNumber": {
                      "nullable": true,
                      "type": "string"
                    },
                    "premisesNumber": {
                      "nullable": true,
                      "type": "string"
                    },
                    "postalCode": {
                      "nullable": true,
                      "type": "string"
                    },
                    "city": {
                      "nullable": true,
                      "type": "string"
                    },
                    "country": {
                      "nullable": true,
                      "type": "string"
                    },
                    "countryId": {
                      "nullable": true,
                      "type": "string"
                    },
                    "county": {
                      "nullable": true,
                      "type": "string"
                    },
                    "district": {
                      "nullable": true,
                      "type": "string"
                    },
                    "state": {
                      "nullable": true,
                      "type": "string"
                    },
                    "website": {
                      "nullable": true,
                      "type": "string"
                    },
                    "taxStatus": {
                      "nullable": true,
                      "type": "boolean"
                    },
                    "verifiedAt": {
                      "nullable": true,
                      "type": "string"
                    },
                    "sources": {
                      "type": "object",
                      "properties": {
                        "gus": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "not_found",
                            "unavailable",
                            "not_applicable"
                          ],
                          "description": "ok — rejestr odpowiedział i miał dane; not_found — odpowiedział, ale nie zna podmiotu; unavailable — niedostępny; not_applicable — nie dotyczy tego zapytania"
                        },
                        "vat": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "not_found",
                            "unavailable",
                            "not_applicable"
                          ],
                          "description": "ok — rejestr odpowiedział i miał dane; not_found — odpowiedział, ale nie zna podmiotu; unavailable — niedostępny; not_applicable — nie dotyczy tego zapytania"
                        }
